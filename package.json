{
  "name": "@exadev/release-gate",
  "version": "1.0.0",
  "description": "Tag and push a semantic-release release, then finish publishing it later -- from a separate process, after an external gate -- without semantic-release core supporting this natively",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "semantic-release",
    "release",
    "git",
    "publish",
    "deployment-gate",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/release-gate.git"
  },
  "dependencies": {
    "env-ci": "^11.2.0",
    "semantic-release": "25.0.9",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@exadev/eslint-config": "^2.10.6",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@types/node": "24.13.3",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "5.0.0"
  },
  "scripts": {
    "build": "turbo run _build",
    "_build": "tsdown",
    "lint": "turbo run _lint",
    "_lint": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "turbo run _typecheck",
    "_typecheck": "tsc -p tsconfig.json",
    "test": "turbo run _test",
    "_test": "vitest run",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && tsdown && publint && attw --pack",
    "prepare": "husky",
    "release": "semantic-release"
  }
}
